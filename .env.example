# Скопируйте в .env рядом с docker-compose.yml: cp .env.example .env
# Затем: docker compose up --build

# ─── Postgres ────────────────────────────────────────────────────────
POSTGRES_DB=quizflow
POSTGRES_USER=quizflow
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ─── Django ──────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=False
# Домен(ы), через которые реально открывают сайт — через запятую.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example.com
CORS_ALLOW_ALL_ORIGINS=True

# Публичный адрес — тот, что видят пользователи в адресной строке (через
# него идёт OAuth-редирект и ссылка сброса пароля в письме). Один и тот же
# nginx (сервис frontend) отдаёт и сайт, и проксирует /api и /ws на
# backend — поэтому оба адреса ниже обычно совпадают и не включают порт.
BACKEND_BASE_URL=http://localhost
FRONTEND_URL=http://localhost

# ─── Вход через Google (необязательно) ──────────────────────────────
# https://console.cloud.google.com/apis/credentials — "Web application",
# authorized redirect URI = GOOGLE_OAUTH_REDIRECT_URI ниже.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/api/auth/oauth/google/callback/

# ─── Вход через VK ID (необязательно) ───────────────────────────────
# https://id.vk.com/business/go/docs/vkid/latest/vk-id/connection/create-application
VK_OAUTH_CLIENT_ID=
VK_OAUTH_REDIRECT_URI=http://localhost/api/auth/oauth/vk/callback/

# ─── Почта для сброса пароля (необязательно) ────────────────────────
# По умолчанию письма печатаются в лог контейнера backend (docker compose
# logs backend) — рабочий вариант для первого запуска без настоящего SMTP.
# Для реальной отправки раскомментируйте и заполните:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=QuizVK <no-reply@yourdomain.com>

# ─── AI-сервис генерации квизов ─────────────────────────────────────
# Обязателен для кнопки «Сгенерировать с помощью ИИ» — без него весь
# остальной сайт работает как обычно, недоступна только сама генерация.
# Получить ключ: https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ─── Адреса фронтенда для бэкендов (обычно не трогать) ──────────────
# Пусто = запросы идут на тот же origin, с которого отдана страница —
# верно почти всегда, раз nginx фронтенда сам проксирует /api, /ws и /ai.
# Заполняйте, только если фронтенд и бэкенды намеренно на разных доменах.
QUIZVK_API_BASE=
QUIZVK_WS_BASE=
QUIZVK_AI_SERVICE_BASE=/ai

# ─── HTTPS (необязательно) ───────────────────────────────────────────
# Нужны только вместе с docker-compose.https.yml — см. корневой README,
# раздел "Разворачиваем на настоящем сервере". DOMAIN должен реально
# указывать A-записью на IP этого сервера, иначе Let's Encrypt не выдаст
# сертификат.
# DOMAIN=your-domain.com
# ACME_EMAIL=you@your-domain.com
