# Скопируйте в .env и подставьте свой ключ.

# Обязательно — без него сервис поднимется, но любой запрос на генерацию
# будет падать с 500. Получить ключ: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Необязательно — есть разумные значения по умолчанию.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_TIMEOUT_SECONDS=60
MAX_QUESTIONS_PER_REQUEST=15

# CORS — как и на основном бэкенде, в деве разрешаем всё.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
