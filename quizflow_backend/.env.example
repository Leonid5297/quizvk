# Скопируйте этот файл в .env и поправьте под себя.
# Для локального запуска можно вообще ничего не менять — есть разумные значения по умолчанию.

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Moscow

# Разрешить все источники для CORS (удобно в разработке).
# В проде замените на CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# Если POSTGRES_DB не задан — используется SQLite (db.sqlite3), без доп. настройки.
# POSTGRES_DB=quizflow
# POSTGRES_USER=quizflow
# POSTGRES_PASSWORD=quizflow
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Для продакшена: один и тот же Redis используется и для канала WebSocket
# (channels_redis, несколько воркеров), и как бэкенд кэша (см. quizzes/caching.py).
# Без этой переменной кэш просто живёт в памяти процесса — ок для одного dev-инстанса.
# REDIS_URL=redis://localhost:6379/0

# Публичный адрес самого бэкенда — используется, чтобы ссылки на медиа
# в событиях WebSocket-игры были абсолютными (не /media/..., а полным URL).
BACKEND_BASE_URL=http://localhost:8000

# Адрес фронтенда — сюда редиректит браузер после OAuth-логина и сюда же
# ведёт ссылка сброса пароля в письме.
FRONTEND_URL=http://localhost:5173

# ─── Вход через Google ──────────────────────────────────────────────
# Получить: https://console.cloud.google.com/apis/credentials
# Тип — "Web application", authorized redirect URI:
#   http://localhost:8000/api/auth/oauth/google/callback/  (или GOOGLE_OAUTH_REDIRECT_URI ниже)
# Без этих переменных кнопка «Войти через Google» просто отдаст 503.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback/

# ─── Вход через VK ID ────────────────────────────────────────────────
# Получить: https://id.vk.com/business/go/docs/vkid/latest/vk-id/connection/create-application
# redirect URI в настройках приложения должен совпадать с указанным ниже.
# VK_OAUTH_CLIENT_ID=
# VK_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/oauth/vk/callback/

# ─── Почта (сброс пароля) ────────────────────────────────────────────
# По умолчанию письма печатаются в консоль сервера — ссылку для сброса
# пароля можно скопировать оттуда без настоящего SMTP. Для реальной
# отправки раскомментируйте и заполните:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=QuizVK <no-reply@yourdomain.com>
