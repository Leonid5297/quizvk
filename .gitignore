# ─── Секреты ──────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Python (backend, ai_service) ────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
venv/
.venv/
*.log

# Django
db.sqlite3
staticfiles/
media/*
!media/.gitkeep

