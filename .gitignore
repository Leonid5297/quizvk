node_modules/
dist/
.vite/
npm-debug.log*

# ─── Docker / Caddy рантайм-данные ────────────────────────────────────
caddy_data/
caddy_config/

# ─── ОС / редакторы ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
